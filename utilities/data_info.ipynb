    "import os\n",
    "\n",
    "dataset_path = input(\"Enter the path to the main dataset folder (e.g., '..\\\\images'): \")\n",
    "\n",
    "if not os.path.isdir(dataset_path):\n",
    "    print(\"Invalid path.\")\n",
    "else:\n",
    "    # Print dataset folder path and expected structure\n",
    "    print(f\"\\nDataset folder: {dataset_path}\\n\")\n",
    "\n",
    "    patient_list = [d for d in os.listdir(dataset_path) if os.path.isdir(os.path.join(dataset_path, d))]\n",
    "    print(f\"\\nFound {len(patient_list)} patient folders.\\nPatient IDs stored in the variable: patient_list.\")"
   ]
