   ],
   "source": [
    "import os\n",
    "import nibabel as nib\n",
    "\n",
    "patient_id = input(\"Enter the patient ID (as in the folder name): \")\n",
    "patient_folder = os.path.join(dataset_path, patient_id)\n",
    "\n",
    "if not os.path.isdir(patient_folder):\n",
    "    print(\"Patient folder not found.\")\n",
    "else:\n",
    "    print(f\"Patient folder: {patient_folder}\")\n",
    "\n",
    "    nifti_files = [f for f in os.listdir(patient_folder) if f.endswith(\".nii\") or f.endswith(\".nii.gz\")]\n",
    "\n",
    "    if not nifti_files:\n",
    "        print(\"No NIfTI files found.\")\n",
    "    else:\n",
    "        print(f\"Found {len(nifti_files)} NIfTI file(s):\")\n",
    "\n",
    "        for f in nifti_files:\n",
    "            path = os.path.join(patient_folder, f)\n",
    "            try:\n",
    "                img = nib.load(path)\n",
    "                shape = img.shape\n",
    "                dtype = img.get_data_dtype()\n",
    "                zooms = img.header.get_zooms()\n",
    "                spacing = zooms[:2]\n",
    "                thickness = zooms[2] if len(zooms) > 2 else \"Unknown\"\n",
    "\n",
    "                print(f\"  - {f} | shape: {shape}, dtype: {dtype}, spacing: {spacing} mm, thickness: {thickness} mm\")\n",
    "            except Exception as e:\n",
    "                print(f\"  - {f}: error loading ({e})\")"
   ]
